# Database
DATABASE_URL=postgresql+asyncpg://nebula:password@localhost:5432/nebula_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Crypto.com Public API
CRYPTO_API_BASE=https://api.crypto.com/exchange/v1/public

# App
APP_NAME=Nebula
ENVIRONMENT=development

# CORS - add your mobile app origin
ALLOWED_ORIGINS=*
